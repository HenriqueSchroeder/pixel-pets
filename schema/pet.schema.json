{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/HenriqueSchroeder/pixel-pets/main/schema/pet.schema.json",
  "title": "pixel-pets pet pack",
  "description": "A pet for the pixel-pets Claude Code plugin. Sprites are rows of palette letters; '.' is see-through. The plugin checks the same rules at load time (hooks/pack.ts).",
  "type": "object",
  "required": [
    "name",
    "palette",
    "main",
    "mini"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "name": {
      "description": "Matches the file name without .json.",
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{0,40}$"
    },
    "author": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "palette": {
      "description": "One-character letters to #rrggbb colors. '.' is reserved for see-through.",
      "type": "object",
      "maxProperties": 16,
      "propertyNames": {
        "minLength": 1,
        "maxLength": 1,
        "not": {
          "const": "."
        }
      },
      "additionalProperties": {
        "type": "string",
        "pattern": "^#[0-9a-fA-F]{6}$"
      }
    },
    "fps": {
      "description": "Animation frames per second.",
      "type": "number",
      "minimum": 1,
      "maximum": 12,
      "default": 4
    },
    "main": {
      "type": "object",
      "required": [
        "moods"
      ],
      "properties": {
        "moods": {
          "description": "Frames per mood. Only sleeping is required; a missing mood borrows its nearest drawn parent's frames (see README). Every frame of the main pet has the same size, at most 48x32.",
          "type": "object",
          "required": [
            "sleeping"
          ],
          "additionalProperties": false,
          "properties": {
            "sleeping": {
              "$ref": "#/$defs/mainFrames"
            },
            "deepSleep": {
              "$ref": "#/$defs/mainFrames"
            },
            "idle": {
              "$ref": "#/$defs/mainFrames"
            },
            "sleepy": {
              "$ref": "#/$defs/mainFrames"
            },
            "tired": {
              "$ref": "#/$defs/mainFrames"
            },
            "walking": {
              "$ref": "#/$defs/mainFrames"
            },
            "watching": {
              "$ref": "#/$defs/mainFrames"
            },
            "thinking": {
              "$ref": "#/$defs/mainFrames"
            },
            "waking": {
              "$ref": "#/$defs/mainFrames"
            },
            "typing": {
              "$ref": "#/$defs/mainFrames"
            },
            "running": {
              "$ref": "#/$defs/mainFrames"
            },
            "writing": {
              "$ref": "#/$defs/mainFrames"
            },
            "reading": {
              "$ref": "#/$defs/mainFrames"
            },
            "searching": {
              "$ref": "#/$defs/mainFrames"
            },
            "supervising": {
              "$ref": "#/$defs/mainFrames"
            },
            "compacting": {
              "$ref": "#/$defs/mainFrames"
            },
            "sweating": {
              "$ref": "#/$defs/mainFrames"
            },
            "worried": {
              "$ref": "#/$defs/mainFrames"
            },
            "grumpy": {
              "$ref": "#/$defs/mainFrames"
            },
            "proud": {
              "$ref": "#/$defs/mainFrames"
            },
            "happy": {
              "$ref": "#/$defs/mainFrames"
            },
            "celebrating": {
              "$ref": "#/$defs/mainFrames"
            },
            "sad": {
              "$ref": "#/$defs/mainFrames"
            }
          }
        },
        "variants": {
          "description": "More loops for a mood the pack draws in main.moods; one is picked at random each time the mood starts. A mood that borrows its frames borrows these too.",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "sleeping": {
              "type": "array",
              "minItems": 1,
              "maxItems": 4,
              "items": {
                "$ref": "#/$defs/mainFrames"
              }
            },
            "deepSleep": {
              "type": "array",
              "minItems": 1,
              "maxItems": 4,
              "items": {
                "$ref": "#/$defs/mainFrames"
              }
            },
            "idle": {
              "type": "array",
              "minItems": 1,
              "maxItems": 4,
              "items": {
                "$ref": "#/$defs/mainFrames"
              }
            },
            "sleepy": {
              "type": "array",
              "minItems": 1,
              "maxItems": 4,
              "items": {
                "$ref": "#/$defs/mainFrames"
              }
            },
            "tired": {
              "type": "array",
              "minItems": 1,
              "maxItems": 4,
              "items": {
                "$ref": "#/$defs/mainFrames"
              }
            },
            "walking": {
              "type": "array",
              "minItems": 1,
              "maxItems": 4,
              "items": {
                "$ref": "#/$defs/mainFrames"
              }
            },
            "watching": {
              "type": "array",
              "minItems": 1,
              "maxItems": 4,
              "items": {
                "$ref": "#/$defs/mainFrames"
              }
            },
            "thinking": {
              "type": "array",
              "minItems": 1,
              "maxItems": 4,
              "items": {
                "$ref": "#/$defs/mainFrames"
              }
            },
            "waking": {
              "type": "array",
              "minItems": 1,
              "maxItems": 4,
              "items": {
                "$ref": "#/$defs/mainFrames"
              }
            },
            "typing": {
              "type": "array",
              "minItems": 1,
              "maxItems": 4,
              "items": {
                "$ref": "#/$defs/mainFrames"
              }
            },
            "running": {
              "type": "array",
              "minItems": 1,
              "maxItems": 4,
              "items": {
                "$ref": "#/$defs/mainFrames"
              }
            },
            "writing": {
              "type": "array",
              "minItems": 1,
              "maxItems": 4,
              "items": {
                "$ref": "#/$defs/mainFrames"
              }
            },
            "reading": {
              "type": "array",
              "minItems": 1,
              "maxItems": 4,
              "items": {
                "$ref": "#/$defs/mainFrames"
              }
            },
            "searching": {
              "type": "array",
              "minItems": 1,
              "maxItems": 4,
              "items": {
                "$ref": "#/$defs/mainFrames"
              }
            },
            "supervising": {
              "type": "array",
              "minItems": 1,
              "maxItems": 4,
              "items": {
                "$ref": "#/$defs/mainFrames"
              }
            },
            "compacting": {
              "type": "array",
              "minItems": 1,
              "maxItems": 4,
              "items": {
                "$ref": "#/$defs/mainFrames"
              }
            },
            "sweating": {
              "type": "array",
              "minItems": 1,
              "maxItems": 4,
              "items": {
                "$ref": "#/$defs/mainFrames"
              }
            },
            "worried": {
              "type": "array",
              "minItems": 1,
              "maxItems": 4,
              "items": {
                "$ref": "#/$defs/mainFrames"
              }
            },
            "grumpy": {
              "type": "array",
              "minItems": 1,
              "maxItems": 4,
              "items": {
                "$ref": "#/$defs/mainFrames"
              }
            },
            "proud": {
              "type": "array",
              "minItems": 1,
              "maxItems": 4,
              "items": {
                "$ref": "#/$defs/mainFrames"
              }
            },
            "happy": {
              "type": "array",
              "minItems": 1,
              "maxItems": 4,
              "items": {
                "$ref": "#/$defs/mainFrames"
              }
            },
            "celebrating": {
              "type": "array",
              "minItems": 1,
              "maxItems": 4,
              "items": {
                "$ref": "#/$defs/mainFrames"
              }
            },
            "sad": {
              "type": "array",
              "minItems": 1,
              "maxItems": 4,
              "items": {
                "$ref": "#/$defs/mainFrames"
              }
            }
          }
        },
        "transitions": {
          "description": "Frames played once when the mood changes, keyed \"from>to\". Either side may be \"*\", not both. An exact key wins over \"from>*\", which wins over \"*>to\".",
          "type": "object",
          "maxProperties": 32,
          "propertyNames": {
            "pattern": "^(\\*|sleeping|deepSleep|idle|sleepy|tired|walking|watching|thinking|waking|typing|running|writing|reading|searching|supervising|compacting|sweating|worried|grumpy|proud|happy|celebrating|sad)>(\\*|sleeping|deepSleep|idle|sleepy|tired|walking|watching|thinking|waking|typing|running|writing|reading|searching|supervising|compacting|sweating|worried|grumpy|proud|happy|celebrating|sad)$",
            "not": {
              "const": "*>*"
            }
          },
          "additionalProperties": {
            "$ref": "#/$defs/mainFrames"
          }
        },
        "actions": {
          "description": "Frames played once at random while the pet is in one of `moods`: blinks, ear twitches, yawns. `every` is [min, max] seconds between the end of one play and the next.",
          "type": "object",
          "maxProperties": 16,
          "additionalProperties": {
            "type": "object",
            "required": [
              "frames",
              "moods",
              "every"
            ],
            "additionalProperties": false,
            "properties": {
              "frames": {
                "$ref": "#/$defs/mainFrames"
              },
              "moods": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "enum": [
                    "sleeping",
                    "deepSleep",
                    "idle",
                    "sleepy",
                    "tired",
                    "walking",
                    "watching",
                    "thinking",
                    "waking",
                    "typing",
                    "running",
                    "writing",
                    "reading",
                    "searching",
                    "supervising",
                    "compacting",
                    "sweating",
                    "worried",
                    "grumpy",
                    "proud",
                    "happy",
                    "celebrating",
                    "sad"
                  ]
                }
              },
              "every": {
                "type": "array",
                "minItems": 2,
                "maxItems": 2,
                "items": {
                  "type": "number",
                  "minimum": 1,
                  "maximum": 600
                }
              },
              "startles": {
                "description": "The frame, counted from 0, from which the agents' mini pets play `startled`, from its first frame, until the action ends: a whip's crack, a roar.",
                "type": "integer",
                "minimum": 0,
                "maximum": 15
              }
            }
          },
          "propertyNames": {
            "pattern": "^[a-zA-Z][a-zA-Z0-9_-]{0,31}$"
          }
        },
        "activities": {
          "description": "Longer scenes played now and then while the pet is in one of `moods`, and it stays put meanwhile: `start` once, `loop` for `seconds` [min, max], `end` once. `every` is [min, max] seconds between the end of one and the next. `label` is what Claude's line says meanwhile, by language code; a language left out says the `en` one. Up from a nap, one comes before long.",
          "type": "object",
          "maxProperties": 8,
          "additionalProperties": {
            "type": "object",
            "required": ["loop", "seconds", "moods", "every"],
            "additionalProperties": false,
            "properties": {
              "start": { "$ref": "#/$defs/mainFrames" },
              "loop": { "$ref": "#/$defs/mainFrames" },
              "end": { "$ref": "#/$defs/mainFrames" },
              "seconds": {
                "type": "array",
                "minItems": 2,
                "maxItems": 2,
                "items": { "type": "number", "minimum": 5, "maximum": 300 }
              },
              "moods": { "$ref": "#/properties/main/properties/actions/additionalProperties/properties/moods" },
              "every": { "$ref": "#/properties/main/properties/actions/additionalProperties/properties/every" },
              "label": {
                "type": "object",
                "propertyNames": { "pattern": "^[a-zA-Z]{2,3}(-[a-zA-Z0-9]{2,8})?$" },
                "additionalProperties": { "type": "string", "minLength": 1, "maxLength": 40 }
              }
            }
          },
          "propertyNames": {
            "pattern": "^[a-zA-Z][a-zA-Z0-9_-]{0,31}$"
          }
        },
        "teleport": {
          "description": "For a pet that does not walk: played to get about instead. `vanish` plays where it stands, then it lands at the new spot and `appear` plays there. A pack that draws `walking` walks and never teleports.",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "vanish",
            "appear"
          ],
          "properties": {
            "vanish": {
              "$ref": "#/$defs/mainFrames"
            },
            "appear": {
              "$ref": "#/$defs/mainFrames"
            }
          }
        }
      }
    },
    "mini": {
      "description": "The small pet drawn for each subagent, at most 12x12; false for none, and the agents show only as the main pet's supervising.",
      "oneOf": [
        {
          "const": false
        },
        {
          "type": "object",
          "required": [
            "moods"
          ],
          "properties": {
            "tint": {
              "description": "The palette letter recolored per subagent.",
              "type": "string",
              "minLength": 1,
              "maxLength": 1,
              "default": "b"
            },
            "moods": {
              "description": "Only working is required; happy and sad (shown for a moment when the agent ends) and startled (while an action of the main pet that `startles` them plays) fall back to it.",
              "type": "object",
              "required": [
                "working"
              ],
              "additionalProperties": false,
              "properties": {
                "working": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 16,
                  "items": {
                    "$ref": "#/$defs/miniFrame"
                  }
                },
                "happy": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 16,
                  "items": {
                    "$ref": "#/$defs/miniFrame"
                  }
                },
                "sad": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 16,
                  "items": {
                    "$ref": "#/$defs/miniFrame"
                  }
                },
                "startled": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 16,
                  "items": {
                    "$ref": "#/$defs/miniFrame"
                  }
                }
              }
            }
          }
        }
      ]
    },
    "personality": {
      "description": "How the pet is made: each trait from 0 to 1, the usual 0.5 when left out. They shape its wants, not its drawing.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "energetic": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "How slowly it tires while awake or at work: 1 tires at half the usual pace, 0 at one and a half."
        },
        "curious": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "How soon it gets bored with nothing to do, and gets up from a nap on its own: 0 never does."
        },
        "affectionate": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "How soon it misses you while you are away: 0 never does."
        }
      }
    },
    "speech": {
      "description": "The pet's own lines, by language code (\"en\", \"pt-BR\"). Shown now and then in quotes on Claude's line; a language or situation left out says the locale's line.",
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-zA-Z]{2,3}(-[a-zA-Z0-9]{2,8})?$"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "longThink": {
            "type": "array",
            "minItems": 1,
            "maxItems": 8,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 40,
              "pattern": "^[^\\u0000-\\u001f\\u007f]*\\S[^\\u0000-\\u001f\\u007f]*$"
            },
            "description": "Thinking for over 30 seconds with no tool."
          },
          "manyReads": {
            "type": "array",
            "minItems": 1,
            "maxItems": 8,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 40,
              "pattern": "^[^\\u0000-\\u001f\\u007f]*\\S[^\\u0000-\\u001f\\u007f]*$"
            },
            "description": "The 20th file read in a turn."
          },
          "manyAgents": {
            "type": "array",
            "minItems": 1,
            "maxItems": 8,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 40,
              "pattern": "^[^\\u0000-\\u001f\\u007f]*\\S[^\\u0000-\\u001f\\u007f]*$"
            },
            "description": "Three or more subagents at work at once."
          },
          "lateNight": {
            "type": "array",
            "minItems": 1,
            "maxItems": 8,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 40,
              "pattern": "^[^\\u0000-\\u001f\\u007f]*\\S[^\\u0000-\\u001f\\u007f]*$"
            },
            "description": "A prompt sent at night, once a session."
          },
          "bored": {
            "type": "array",
            "minItems": 1,
            "maxItems": 8,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 40,
              "pattern": "^[^\\u0000-\\u001f\\u007f]*\\S[^\\u0000-\\u001f\\u007f]*$"
            },
            "description": "Up on its own out of a nap, bored."
          },
          "dreaming": {
            "type": "array",
            "minItems": 1,
            "maxItems": 8,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 40,
              "pattern": "^[^\\u0000-\\u001f\\u007f]*\\S[^\\u0000-\\u001f\\u007f]*$"
            },
            "description": "Talking in its sleep, now and then."
          }
        }
      }
    }
  },
  "$defs": {
    "mainFrames": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "type": "array",
        "minItems": 1,
        "maxItems": 32,
        "items": {
          "type": "string",
          "minLength": 1,
          "maxLength": 48
        }
      }
    },
    "miniFrame": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 12
      }
    }
  }
}
