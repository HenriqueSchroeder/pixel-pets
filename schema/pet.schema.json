{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/HenriqueSchroeder/pixel-pets/main/schema/pet.schema.json",
  "title": "pixel-pets pet pack",
  "description": "A pet for the pixel-pets Claude Code plugin. Sprites are rows of palette letters; '.' is see-through. The plugin checks the same rules at load time (hooks/pack.ts).",
  "type": "object",
  "required": [
    "name",
    "palette",
    "main",
    "mini"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "name": {
      "description": "Matches the file name without .json.",
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{0,40}$"
    },
    "author": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "palette": {
      "description": "One-character letters to #rrggbb colors. '.' is reserved for see-through.",
      "type": "object",
      "maxProperties": 16,
      "propertyNames": {
        "minLength": 1,
        "maxLength": 1,
        "not": {
          "const": "."
        }
      },
      "additionalProperties": {
        "type": "string",
        "pattern": "^#[0-9a-fA-F]{6}$"
      }
    },
    "fps": {
      "description": "Animation frames per second.",
      "type": "number",
      "minimum": 1,
      "maximum": 12,
      "default": 4
    },
    "main": {
      "type": "object",
      "required": [
        "moods"
      ],
      "properties": {
        "moods": {
          "description": "Frames per mood. Only sleeping is required; a missing mood borrows its nearest drawn parent's frames (see README). Every frame of the main pet has the same size, at most 24x24.",
          "type": "object",
          "required": [
            "sleeping"
          ],
          "additionalProperties": false,
          "properties": {
            "sleeping": {
              "$ref": "#/$defs/mainFrames"
            },
            "deepSleep": {
              "$ref": "#/$defs/mainFrames"
            },
            "idle": {
              "$ref": "#/$defs/mainFrames"
            },
            "walking": {
              "$ref": "#/$defs/mainFrames"
            },
            "watching": {
              "$ref": "#/$defs/mainFrames"
            },
            "thinking": {
              "$ref": "#/$defs/mainFrames"
            },
            "waking": {
              "$ref": "#/$defs/mainFrames"
            },
            "typing": {
              "$ref": "#/$defs/mainFrames"
            },
            "running": {
              "$ref": "#/$defs/mainFrames"
            },
            "writing": {
              "$ref": "#/$defs/mainFrames"
            },
            "reading": {
              "$ref": "#/$defs/mainFrames"
            },
            "searching": {
              "$ref": "#/$defs/mainFrames"
            },
            "supervising": {
              "$ref": "#/$defs/mainFrames"
            },
            "compacting": {
              "$ref": "#/$defs/mainFrames"
            },
            "sweating": {
              "$ref": "#/$defs/mainFrames"
            },
            "happy": {
              "$ref": "#/$defs/mainFrames"
            },
            "sad": {
              "$ref": "#/$defs/mainFrames"
            }
          }
        },
        "variants": {
          "description": "More loops for a mood the pack draws in main.moods; one is picked at random each time the mood starts. A mood that borrows its frames borrows these too.",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "sleeping": {
              "type": "array",
              "minItems": 1,
              "maxItems": 4,
              "items": {
                "$ref": "#/$defs/mainFrames"
              }
            },
            "deepSleep": {
              "type": "array",
              "minItems": 1,
              "maxItems": 4,
              "items": {
                "$ref": "#/$defs/mainFrames"
              }
            },
            "idle": {
              "type": "array",
              "minItems": 1,
              "maxItems": 4,
              "items": {
                "$ref": "#/$defs/mainFrames"
              }
            },
            "walking": {
              "type": "array",
              "minItems": 1,
              "maxItems": 4,
              "items": {
                "$ref": "#/$defs/mainFrames"
              }
            },
            "watching": {
              "type": "array",
              "minItems": 1,
              "maxItems": 4,
              "items": {
                "$ref": "#/$defs/mainFrames"
              }
            },
            "thinking": {
              "type": "array",
              "minItems": 1,
              "maxItems": 4,
              "items": {
                "$ref": "#/$defs/mainFrames"
              }
            },
            "waking": {
              "type": "array",
              "minItems": 1,
              "maxItems": 4,
              "items": {
                "$ref": "#/$defs/mainFrames"
              }
            },
            "typing": {
              "type": "array",
              "minItems": 1,
              "maxItems": 4,
              "items": {
                "$ref": "#/$defs/mainFrames"
              }
            },
            "running": {
              "type": "array",
              "minItems": 1,
              "maxItems": 4,
              "items": {
                "$ref": "#/$defs/mainFrames"
              }
            },
            "writing": {
              "type": "array",
              "minItems": 1,
              "maxItems": 4,
              "items": {
                "$ref": "#/$defs/mainFrames"
              }
            },
            "reading": {
              "type": "array",
              "minItems": 1,
              "maxItems": 4,
              "items": {
                "$ref": "#/$defs/mainFrames"
              }
            },
            "searching": {
              "type": "array",
              "minItems": 1,
              "maxItems": 4,
              "items": {
                "$ref": "#/$defs/mainFrames"
              }
            },
            "supervising": {
              "type": "array",
              "minItems": 1,
              "maxItems": 4,
              "items": {
                "$ref": "#/$defs/mainFrames"
              }
            },
            "compacting": {
              "type": "array",
              "minItems": 1,
              "maxItems": 4,
              "items": {
                "$ref": "#/$defs/mainFrames"
              }
            },
            "sweating": {
              "type": "array",
              "minItems": 1,
              "maxItems": 4,
              "items": {
                "$ref": "#/$defs/mainFrames"
              }
            },
            "happy": {
              "type": "array",
              "minItems": 1,
              "maxItems": 4,
              "items": {
                "$ref": "#/$defs/mainFrames"
              }
            },
            "sad": {
              "type": "array",
              "minItems": 1,
              "maxItems": 4,
              "items": {
                "$ref": "#/$defs/mainFrames"
              }
            }
          }
        },
        "transitions": {
          "description": "Frames played once when the mood changes, keyed \"from>to\". Either side may be \"*\", not both. An exact key wins over \"from>*\", which wins over \"*>to\".",
          "type": "object",
          "maxProperties": 32,
          "propertyNames": {
            "pattern": "^(\\*|sleeping|deepSleep|idle|walking|watching|thinking|waking|typing|running|writing|reading|searching|supervising|compacting|sweating|happy|sad)>(\\*|sleeping|deepSleep|idle|walking|watching|thinking|waking|typing|running|writing|reading|searching|supervising|compacting|sweating|happy|sad)$",
            "not": {
              "const": "*>*"
            }
          },
          "additionalProperties": {
            "$ref": "#/$defs/mainFrames"
          }
        },
        "actions": {
          "description": "Frames played once at random while the pet is in one of `moods`: blinks, ear twitches, yawns. `every` is [min, max] seconds between the end of one play and the next.",
          "type": "object",
          "maxProperties": 16,
          "additionalProperties": {
            "type": "object",
            "required": [
              "frames",
              "moods",
              "every"
            ],
            "additionalProperties": false,
            "properties": {
              "frames": {
                "$ref": "#/$defs/mainFrames"
              },
              "moods": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "enum": [
                    "sleeping",
                    "deepSleep",
                    "idle",
                    "walking",
                    "watching",
                    "thinking",
                    "waking",
                    "typing",
                    "running",
                    "writing",
                    "reading",
                    "searching",
                    "supervising",
                    "compacting",
                    "sweating",
                    "happy",
                    "sad"
                  ]
                }
              },
              "every": {
                "type": "array",
                "minItems": 2,
                "maxItems": 2,
                "items": {
                  "type": "number",
                  "minimum": 1,
                  "maximum": 600
                }
              }
            }
          },
          "propertyNames": {
            "pattern": "^[a-zA-Z][a-zA-Z0-9_-]{0,31}$"
          }
        }
      }
    },
    "mini": {
      "description": "The small pet drawn for each subagent, at most 12x12.",
      "type": "object",
      "required": [
        "moods"
      ],
      "properties": {
        "tint": {
          "description": "The palette letter recolored per subagent.",
          "type": "string",
          "minLength": 1,
          "maxLength": 1,
          "default": "b"
        },
        "moods": {
          "description": "Only working is required; happy and sad (shown for a moment when the agent ends) fall back to it.",
          "type": "object",
          "required": [
            "working"
          ],
          "additionalProperties": false,
          "properties": {
            "working": {
              "type": "array",
              "minItems": 1,
              "maxItems": 16,
              "items": {
                "$ref": "#/$defs/miniFrame"
              }
            },
            "happy": {
              "type": "array",
              "minItems": 1,
              "maxItems": 16,
              "items": {
                "$ref": "#/$defs/miniFrame"
              }
            },
            "sad": {
              "type": "array",
              "minItems": 1,
              "maxItems": 16,
              "items": {
                "$ref": "#/$defs/miniFrame"
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "mainFrames": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "type": "array",
        "minItems": 1,
        "maxItems": 24,
        "items": {
          "type": "string",
          "minLength": 1,
          "maxLength": 24
        }
      }
    },
    "miniFrame": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 12
      }
    }
  }
}
